PORT=3001

# Public URL where this backend/app is available.
# In Vercel Production set this to your production domain, for example:
# PUBLIC_APP_URL=https://your-domain.com
PUBLIC_APP_URL=http://localhost:3001

# Optional. Leave empty when frontend and backend are served from the same domain.
# Use only if the frontend is hosted separately and must call a different backend URL.
PUBLIC_API_BASE_URL=

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3001

SESSION_SECRET=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-different-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

BREVO_API_KEY=
BARBER_EMAIL=
